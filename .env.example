# =============================================================================
# EKIA-2 Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Groq LLM ---
GROQ_API_KEY=your-groq-api-key-here

# --- HuggingFace Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Neo4j (Desktop) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# --- Langfuse Observability ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- FAISS Vector Store ---
FAISS_INDEX_PATH=data/faiss_index

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Retrieval Config ---
VECTOR_SEARCH_K=5
GRAPH_SEARCH_DEPTH=2

# --- LLM model on Groq ---
GROQ_MODEL=openai/gpt-oss-20b

# --- Which Neo4j to use ---
# docker-neo4j  -> run Neo4j as a container (NEO4J_URI=bolt://neo4j:7687)
# remove the line below to use Neo4j Desktop instead (NEO4J_URI=bolt://host.docker.internal:7687)
COMPOSE_PROFILES=docker-neo4j
