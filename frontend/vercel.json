{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/graph/", "destination": "Binary file data/tunnel.log matches/api/graph/" },
    { "source": "/api/:path*", "destination": "Binary file data/tunnel.log matches/api/:path*" },
    { "source": "/health", "destination": "Binary file data/tunnel.log matches/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
